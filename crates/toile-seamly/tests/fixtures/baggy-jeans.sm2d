            <line firstPoint="45" id="91" lineColor="black" lineType="none" lineWeight="0.35" secondPoint="59"/>
            <!--Crotch point: front inseam (Line_b_knee_end_B1) minus 0.7 stretching, up the right guideline.-->
            <point firstPoint="77" id="92" length="Line_b_knee_end_B1-0.7" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="bk_crotch_tip" secondPoint="81" showPointName="true" type="alongLine"/>
