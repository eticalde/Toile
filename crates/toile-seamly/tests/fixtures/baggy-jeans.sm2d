    <draftBlock name="belt loops">
        <calculation>
            <!--Belt loop strip (cut 1). NOT from Muller (the book only marks loop positions on
                the waistband, no cut piece) - standard jeans method: strip folded in thirds
                and twin-needle topstitched to a finished width of 1.2 (cut 3 x 1.2 = 3.6),
                then cut into 7 pieces of 6.5 each (4 waistband depth + 2.5 turn-under at the
                ends) for the 7 loops marked on the waistband (wb_l1..wb_l4).-->
            <point id="227" mx="0.132292" my="0.264583" name="bl_0" showPointName="true" type="single" x="36" y="44"/>
            <point angle="0" basePoint="227" id="228" length="7*(4+2.5)" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="bl_1" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="227" id="229" length="3*1.2" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="bl_2" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="228" id="230" length="3*1.2" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="bl_3" showPointName="false" type="endLine"/>
            <line firstPoint="229" id="231" lineColor="black" lineType="solidLine" lineWeight="1" secondPoint="230"/>
        </calculation>
