    <draftBlock name="back pill bag">
        <calculation>
            <!--Bag for the BACK horizontal pill slot (cut 1). Covers the slot plus 1.5 at each
                end, 2 above the slot top and #PhL below the slot bottom: width = #PhL+4,
                height = #PhL+6. Same reel construction as the front (RST over the slot
                marking, sew the pill, cut inside, flip through, iron, topstitch).-->
            <point id="222" mx="0.132292" my="0.264583" name="bb_0" showPointName="true" type="single" x="52" y="16"/>
            <point angle="0" basePoint="222" id="223" length="#PhL+4" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="bb_1" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="222" id="224" length="#PhL+6" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="bb_2" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="223" id="225" length="#PhL+6" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="bb_3" showPointName="false" type="endLine"/>
