            <!--"measure": side waist point to the crease/knee intersection (original crease, b_knee_mid).-->
            <line firstPoint="93" id="96" lineColor="black" lineType="dashLine" lineWeight="0.35" secondPoint="57"/>
            <!--"transfer + 2": swept from b_knee_mid onto the relocated crease line, which runs from
                b_knee_mid through b_hip_1_5_margin (1.5 right at the hip only - the crease is slanted).
                Drawing this point also draws the dashed crease/transfer guide.-->
            <point firstPoint="57" id="97" length="Line_bk_waist_side_b_knee_mid+2" lineColor="black" lineType="dashLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="bk_waist_cb" secondPoint="79" showPointName="true" type="alongLine"/>
