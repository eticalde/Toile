    <draftBlock name="chain cover strip">
        <calculation>
            <!--Denim chain (custom accessory, not from Muller). Strip to cover soft cotton
                cord #CordD thick: width = pi*#CordD + 2 seam + 0.5 turning ease. CUT ON THE
                BIAS (45 - the diagonal dashed tick is the grain mark): straight-grain tubes
                kink when bent into links. Cover a DOUBLE length of cord with the pull-through
                method (sew the tube around the cord's midpoint and slide the cover back over
                the free half - no turning of raw denim tubes needed). Then cut the covered
                cord into link sections: one section = pi*(#LinkIn + tube dia #CordD+0.4) + 2
                join allowance; the dashed cross ticks mark one and two sections. Thread each
                section through the previous closed link, butt the cord ends and hand-stitch
                the cover shut (1 join per link, hidden at a crossing point). Strip drawn 3
                sections long; join bias strips diagonally for longer runs.-->
            <point id="264" mx="0.132292" my="0.264583" name="cs_0" showPointName="true" type="single" x="36" y="74"/>
            <point angle="0" basePoint="264" id="265" length="3*(3.1416*(#LinkIn+#CordD+0.4)+2)" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="cs_1" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="264" id="266" length="3.1416*#CordD+2.5" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="cs_2" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="265" id="267" length="3.1416*#CordD+2.5" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="cs_3" showPointName="false" type="endLine"/>
            <line firstPoint="266" id="268" lineColor="black" lineType="solidLine" lineWeight="1" secondPoint="267"/>
            <point firstPoint="264" id="269" length="3.1416*(#LinkIn+#CordD+0.4)+2" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="cs_u1" secondPoint="265" showPointName="false" type="alongLine"/>
            <point angle="270" basePoint="269" id="270" length="3.1416*#CordD+2.5" lineColor="black" lineType="dashLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="cs_u1t" showPointName="false" type="endLine"/>
            <point firstPoint="264" id="271" length="2*(3.1416*(#LinkIn+#CordD+0.4)+2)" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="cs_u2" secondPoint="265" showPointName="false" type="alongLine"/>
            <point angle="270" basePoint="271" id="272" length="3.1416*#CordD+2.5" lineColor="black" lineType="dashLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="cs_u2t" showPointName="false" type="endLine"/>
            <point firstPoint="264" id="273" length="1.5" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="cs_g0" secondPoint="265" showPointName="false" type="alongLine"/>
            <point angle="315" basePoint="273" id="274" length="3.5" lineColor="black" lineType="dashLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="cs_g1" showPointName="false" type="endLine"/>
        </calculation>
        <modeling><point id="437" idObject="264" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="438" idObject="265" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="439" idObject="267" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="440" idObject="266" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="441" idObject="269" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="442" idObject="270" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="444" idObject="271" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="445" idObject="272" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="447" idObject="273" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="448" idObject="274" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><path cut="false" id="443" inUse="true" lineColor="black" lineType="dashLine" lineWeight="0.35" name="corte eslabon 1" type="2"><nodes><node idObject="441" type="NodePoint"/><node idObject="442" type="NodePoint"/></nodes></path><path cut="false" id="446" inUse="true" lineColor="black" lineType="dashLine" lineWeight="0.35" name="corte eslabon 2" type="2"><nodes><node idObject="444" type="NodePoint"/><node idObject="445" type="NodePoint"/></nodes></path><path cut="false" id="449" inUse="true" lineColor="black" lineType="dashLine" lineWeight="0.35" name="bies 45" type="2"><nodes><node idObject="447" type="NodePoint"/><node idObject="448" type="NodePoint"/></nodes></path></modeling>
