<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <!--Pattern created with Seamly2D v2026.6.29.216 (https://seamly.io).-->
    <version>0.7.4</version>
    <unit>cm</unit>
    <description/>
    <notes/>
    <measurements>../measurements/individual/measurements-eti.smis</measurements>
    <variables>
        <variable description="Front trouser crotch width" formula="(hip_circ/2/10)+1" name="#Ftcw"/>
        <variable description="Total crotch width" formula="(hip_circ/4)-4" name="#Tcw"/>
        <variable description="Back trouser crotch width" formula="(#Tcw-#Ftcw)" name="#Btcw"/>
        <variable description="Back trouser width" formula="(hip_circ/4)+3" name="#Btw"/>
        <variable description="Total back trouser width" formula="#Btw+#Btcw" name="#Tbtw"/>
        <variable description="Largo Lateral" formula="101.5" name="#Sl"/>
        <variable description="Body Rise" formula="#Sl-leg_crotch_to_floor" name="#Br"/>
        <variable description="Foot width" formula="54" name="#Fw"/>
        <variable description="Knee width" formula="56" name="#Kw"/>
        <variable description="Waistband girth" formula="87" name="#Wbg"/>
        <variable description="Ancho delantero" formula="hip_circ/4" name="#Ftw"/>
        <variable description="Altura Rodilla" formula="(leg_crotch_to_floor/2) + (leg_crotch_to_floor/10) - 2" name="#Knh"/>
        <variable description="Cuánto Subir la cadera sobre el tiro" formula="(hip_circ/2/10) + 3" name="#HipUp"/>
        <variable description="Largo celular (Xiaomi 15 Ultra 161.3mm)" formula="16.13" name="#PhL"/>
        <variable description="Ancho celular (Xiaomi 15 Ultra 75.3mm)" formula="7.53" name="#PhW"/>
        <variable description="Grosor celular (Xiaomi 15 Ultra 9.5mm)" formula="0.95" name="#PhD"/>
        <variable description="Diametro cordon relleno cadena (canamo 10 mm)" formula="1.0" name="#CordD"/>
        <variable description="Abertura interior de cada eslabon de la cadena" formula="2.5" name="#LinkIn"/>
    </variables>
    <!--SEAM PLAN (2026-08, ver tab COSTURAS en la pagina Code/Sewing): fell real doble
        pespunte en canesu (acomodo abajo) y entrepierna (SA adelante, embeber 0.7);
        mock-fell en la U del tiro (SA izquierda); costados abiertos con Hong Kong en
        bies de CONTRASTE (tambien bolsas, vista, panel e interior de pretina, ~9m);
        pretina banda+vista (cortar 2x al doblez) con puntada en surco; ruedo doble
        1.5+2 (CORTAR con 3.5). Maquina Singer HD 4423: limite 8 capas - ver cruces
        criticos y mitigaciones en la tab. Orden: plano -> pierna -> tubo -> banda.-->
    <draftBlock name="Baggy Jeans Front [Muller]">
        <calculation>
            <point id="1" mx="0.132292" my="0.264583" name="A" showPointName="true" type="single" x="0.79375" y="1.05833"/>
