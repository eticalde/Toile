    <draftBlock name="pill bag">
        <calculation>
            <!--Pill pocket bag (cut 1 per pocket, any light woven). Rectangle sized to cover
                the phone channel plus 1.5 seam at the sides/bottom and 2 above the slot top:
                width = #PhW+#PhD+4, height = #PhL+5.5. Sewn right sides together over the
                slot marking, then flipped through to the inside (reel steps 2-5).-->
            <point id="184" mx="0.132292" my="0.264583" name="pb_0" showPointName="true" type="single" x="36" y="16"/>
            <point angle="0" basePoint="184" id="185" length="#PhW+#PhD+4" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="pb_1" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="184" id="186" length="#PhL+5.5" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="pb_2" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="185" id="187" length="#PhL+5.5" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="pb_3" showPointName="false" type="endLine"/>
            <line firstPoint="186" id="188" lineColor="black" lineType="solidLine" lineWeight="1" secondPoint="187"/>
        </calculation>
        <modeling><point id="390" idObject="184" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="391" idObject="185" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="392" idObject="187" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/><point id="393" idObject="186" inUse="true" mx="0.1" my="0.2" showPointName="false" type="modeling"/></modeling>
