    <draftBlock name="back flap">
        <calculation>
            <!--Cut piece for the back pocket flap (matches the bp_f*/fs*/fc*/fb* style marks
                on the back): #PhL+4 wide x 6 deep, bottom corners rounded r=2. Cut 2 (outer
                + facing) plus light interlining; top edge is the sewn edge.-->
            <point id="275" mx="0.132292" my="0.264583" name="fl_0" showPointName="true" type="single" x="36" y="86"/>
