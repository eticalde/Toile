            <line firstPoint="168" id="172" lineColor="black" lineType="solidLine" lineWeight="1" secondPoint="170"/>
            <line firstPoint="169" id="173" lineColor="black" lineType="solidLine" lineWeight="1" secondPoint="171"/>
