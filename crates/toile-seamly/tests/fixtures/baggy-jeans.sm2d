            <!--Centre back seam: straight from the waist point down to B3, then the seat curve takes over.-->
            <line firstPoint="97" id="114" lineColor="black" lineType="solidLine" lineWeight="1" secondPoint="87"/>
            <!--Back pocket, v2 2026-08-01: SAME faced pill slot as the front, rotated to
