    <draftBlock name="waistband">
        <calculation>
            <!--Straight jeans waistband (Muller p.134): half waist girth long, 4 cm wide, plus a
                4 cm button extension before c.f. Notches: c.f. and side seam (1/4 Wbg from c.f.);
                the old pocket notch was dropped with the jeans pocket (pill pocket does not
                reach the waist). Cut on fold at c.b. Belt loops 1.2 wide.-->
            <point id="138" mx="0.132292" my="0.264583" name="wb_0" showPointName="false" type="single" x="36" y="11"/>
            <point angle="0" basePoint="138" id="139" length="#Wbg/2+4" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="wb_cb" showPointName="true" type="endLine"/>
            <point angle="90" basePoint="138" id="140" length="4" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="wb_1" showPointName="false" type="endLine"/>
            <point angle="90" basePoint="139" id="141" length="4" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="wb_2" showPointName="false" type="endLine"/>
            <line firstPoint="140" id="142" lineColor="black" lineType="solidLine" lineWeight="1" secondPoint="141"/>
            <point firstPoint="138" id="143" length="4" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="wb_cf" secondPoint="139" showPointName="true" type="alongLine"/>
            <point angle="90" basePoint="143" id="144" length="4" lineColor="black" lineType="dashLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="wb_cf_n" showPointName="false" type="endLine"/>
            <point firstPoint="143" id="147" length="#Wbg/4" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="wb_side" secondPoint="139" showPointName="true" type="alongLine"/>
            <point angle="90" basePoint="147" id="148" length="4" lineColor="black" lineType="dashLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="wb_sd_n" showPointName="false" type="endLine"/>
            <!--Belt loops (Muller p.134), 1.2 wide, marked as solid ticks across the band. Half
                pattern carries 4 marks = 7 loops on the garment. Dimensioned on p.134: l2 ends
                1.5 in front of the side seam; l3 ends 1 in front of the midpoint between side
                seam and c.b.; l4 straddles c.b. (0.6 = half a loop drawn up to the fold).
                l1 has no printed measure on p.134; kept at the spot the parent model Jeans
                p.131 gives (1 in front of the old pocket notch, i.e. 11.5 from the side seam)
                even though the pill pocket removed that notch.-->
            <point firstPoint="147" id="149" length="12.7" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="wb_l1a" secondPoint="143" showPointName="false" type="alongLine"/>
            <point angle="90" basePoint="149" id="150" length="4" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="wb_l1a_n" showPointName="false" type="endLine"/>
