            <point angle="0" basePoint="166" id="169" length="1.5" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_tr" showPointName="false" type="endLine"/>
            <point angle="180" basePoint="167" id="170" length="1.5" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_bl" showPointName="false" type="endLine"/>
