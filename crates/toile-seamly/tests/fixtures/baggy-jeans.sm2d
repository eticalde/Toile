            <spline angle1="276.734" angle2="359.611" color="black" id="42" length="10.1798" length1="9.2803" length2="0.0585578" lineWeight="1" penStyle="solidLine" point1="7" point4="35" type="simpleInteractive"/>
            <!--Pill phone pocket (custom design, replaces the p.134 extended jeans pocket).
                Faced slot opening: pill 3 wide x #PhL+1 long, vertical, centreline midway
                between the crease and the side seam, top edge 7 below the waist level.
                Phone channel (dashed): topstitch through front + bag, #PhW+#PhD+1 wide,
                #PhL+2 deep from the slot top, holds the phone snug behind the slot.
                Construction (reel Da-l3DPpAfv): 1 mark slot on wrong side of front; 2 pill
                bag piece right sides together over it; 3 sew around the pill; 4 cut inside
                the pill w/ small allowance; 5 flip bag through to the inside; 6 iron;
                7 topstitch the slot edge, then the channel. Bag piece: "pill bag" block.-->
            <point angle="270" basePoint="20" id="163" length="7" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_ref" showPointName="false" type="endLine"/>
            <point angle="180" basePoint="163" id="164" length="(#Ftw+#Ftcw)/4" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_ct" showPointName="true" type="endLine"/>
            <point angle="270" basePoint="164" id="165" length="#PhL+1" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_cb" showPointName="false" type="endLine"/>
