    <draftBlock name="fly button stand">
        <calculation>
            <!--Right fly button stand / underlap (cut 1). 8 x 17 folded lengthwise on the
                dashed line to a finished 4 x 17; 3 button marks on the folded half's centre
                (2 from the fold), at 5 / 9.5 / 14 from the top, matching the buttonholes on
                "fly facing". Standard jeans method, not from Muller.-->
            <point id="250" mx="0.132292" my="0.264583" name="bs_0" showPointName="true" type="single" x="51" y="52"/>
            <point angle="0" basePoint="250" id="251" length="8" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="bs_1" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="250" id="252" length="17" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="bs_2" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="251" id="253" length="17" lineColor="black" lineType="solidLine" lineWeight="1" mx="0.132292" my="0.264583" name="bs_3" showPointName="false" type="endLine"/>
            <line firstPoint="252" id="254" lineColor="black" lineType="solidLine" lineWeight="1" secondPoint="253"/>
