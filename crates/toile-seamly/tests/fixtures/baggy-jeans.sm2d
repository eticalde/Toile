            <arc angle1="180" angle2="0" center="167" color="black" id="175" lineWeight="1" penStyle="solidLine" radius="1.5" type="simple"/>
            <point angle="180" basePoint="164" id="176" length="(#PhW+#PhD+1)/2" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_chtl" showPointName="false" type="endLine"/>
            <point angle="0" basePoint="164" id="177" length="(#PhW+#PhD+1)/2" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_chtr" showPointName="false" type="endLine"/>
            <point angle="270" basePoint="164" id="178" length="#PhL+2-((#PhW+#PhD+1)/2)" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_chc" showPointName="false" type="endLine"/>
            <point angle="180" basePoint="178" id="179" length="(#PhW+#PhD+1)/2" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_chbl" showPointName="false" type="endLine"/>
            <point angle="0" basePoint="178" id="180" length="(#PhW+#PhD+1)/2" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="pp_chbr" showPointName="false" type="endLine"/>
            <line firstPoint="176" id="181" lineColor="black" lineType="dashLine" lineWeight="0.35" secondPoint="179"/>
            <line firstPoint="177" id="182" lineColor="black" lineType="dashLine" lineWeight="0.35" secondPoint="180"/>
            <arc angle1="180" angle2="0" center="178" color="black" id="183" lineWeight="0.35" penStyle="dashLine" radius="(#PhW+#PhD+1)/2" type="simple"/>
            <!--Button fly (NOT from Muller - the book only drafts zipper flies; p.134 says
                zipper 16 / stitching 3.5). Standard jeans button-fly adaptation: same 16
                opening, J topstitch widened to 4 to clear the buttonhole stand. ff_hook sits
                on the fork chord so the J ends 16 below the waist along the c.f. edge.
                3 fly buttons at 5 / 9.5 / 14 below the waist (plus the waistband button).
                ff_hook is a cutSpline ON the c.f. curve: an alongLine here would measure
                along the straight CHORD and land ~1.2 cm outside the seam line (the
                curve bows inward). Found 2026-08-07 by the seam-plan audit.
                Pieces: "fly facing" (left, buttonholes) and "fly button stand" (right).-->
            <point firstPoint="27" id="232" length="4" lineColor="black" lineType="none" lineWeight="0.35" mx="0.132292" my="0.264583" name="ff_top" secondPoint="29" showPointName="false" type="alongLine"/>
            <point id="233" length="16-Spl_waist_margin_end_hip_end" lineColor="black" mx="0.132292" my="0.264583" name="ff_hook" showPointName="false" spline="42" type="cutSpline"/>
            <spline angle1="277" angle2="165" color="black" id="234" length="16" length1="10" length2="2.5" lineWeight="0.35" penStyle="dashLine" point1="232" point4="233" type="simpleInteractive"/>
        </calculation>
