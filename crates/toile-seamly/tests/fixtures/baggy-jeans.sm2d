            <point angle="0" basePoint="21" id="22" length="(#Fw/4)-1" lineColor="black" lineType="dashLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="foot_end" showPointName="true" type="endLine"/>
            <point angle="180" basePoint="21" id="23" length="(#Fw/4)-1" lineColor="black" lineType="dashLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="foot_start" showPointName="true" type="endLine"/>
            <point angle="90" basePoint="21" id="24" length="#Knh" lineColor="black" lineType="dashLine" lineWeight="0.35" mx="0.132292" my="0.264583" name="knee_mid" showPointName="true" type="endLine"/>
